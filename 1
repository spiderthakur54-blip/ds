-- Part A: INNER JOIN
SELECT C.Customer_ID, C.Customer_Name,
       A.Account_ID, A.Account_Type, A.Balance
FROM Customer C
INNER JOIN Account A
ON C.Customer_ID = A.Customer_ID;

-- Part A: LEFT OUTER JOIN
SELECT C.Customer_ID, C.Customer_Name,
       A.Account_ID, A.Balance
FROM Customer C
LEFT JOIN Account A
ON C.Customer_ID = A.Customer_ID;

-- Part A: RIGHT OUTER JOIN
SELECT C.Customer_Name, A.Account_ID,
       A.Account_Type, A.Balance
FROM Customer C
RIGHT JOIN Account A
ON C.Customer_ID = A.Customer_ID;

-- Part A: SELF JOIN
SELECT C.Customer_Name AS Customer,
       M.Customer_Name AS Manager
FROM Customer C
LEFT JOIN Customer M
ON C.Manager_ID = M.Customer_ID;

-- Part B: Create Banking_Details_View
CREATE VIEW Banking_Details_View AS
SELECT
    C.Customer_ID,
    C.Customer_Name,
    C.City,
    A.Account_ID,
    A.Account_Type,
    A.Balance,
    T.Transaction_ID,
    T.Transaction_Type,
    T.Amount,
    T.Transaction_Date
FROM Customer C
INNER JOIN Account A
    ON C.Customer_ID = A.Customer_ID
INNER JOIN Bank_Transaction T
    ON A.Account_ID = T.Account_ID;

-- Display Banking Details View
SELECT * FROM Banking_Details_View;

-- Part C: Create High_Value_Transaction_View
CREATE VIEW High_Value_Transaction_View AS
SELECT
    T.Transaction_ID,
    C.Customer_Name,
    A.Account_ID,
    T.Transaction_Type,
    T.Amount,
    T.Transaction_Date
FROM Bank_Transaction T
INNER JOIN Account A
    ON T.Account_ID = A.Account_ID
INNER JOIN Customer C
    ON A.Customer_ID = C.Customer_ID
WHERE T.Amount > 10000;

-- Display High Value Transaction View
SELECT * FROM High_Value_Transaction_View;

