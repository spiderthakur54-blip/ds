

CREATE DATABASE COLLEGE;
USE COLLEGE;

CREATE TABLE DEPT (
    Dept_ID INT PRIMARY KEY,
    Dept_Name VARCHAR(30),
    Location VARCHAR(30)
);

CREATE TABLE STUDENT (
    Student_ID INT PRIMARY KEY AUTO_INCREMENT,
    Student_Name VARCHAR(50),
    Email VARCHAR(100),
    Age INT,
    Gender VARCHAR(10),
    Dept_ID INT,
    Marks DECIMAL(5,2),
    FOREIGN KEY (Dept_ID)
        REFERENCES DEPT(Dept_ID)
);

CREATE TABLE STUDENT (
    Student_ID INT PRIMARY KEY AUTO_INCREMENT,
    Student_Name VARCHAR(50),
    Email VARCHAR(100),
    Age INT,
    Gender VARCHAR(10),
    Dept_ID INT,
    Marks DECIMAL(5,2),
    FOREIGN KEY (Dept_ID)
        REFERENCES DEPT(Dept_ID)
);

