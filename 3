	SELECT s.stud_id,s.stud_name
	FROM Student s
	JOIN Enrollment e ON e.stud_id = s.stud_id
	JOIN Course c ON e.course_id = c.course_id
	WHERE c.dept_id = s.dept_id
	GROUP BY s.stud_id,s.stud_name,s.dept_id
	HAVING COUNT(DISTINCT c.course_id) = (
		SELECT COUNT(*)
		FROM Course c2
		WHERE c2.dept_id = s.dept_id
		);
		
	SELECT c.course_id,c.course_name 
	FROM Course c
	LEFT JOIN Enrollment e
	ON c.course_id = e.course_id
	WHERE e.stud_id IS NULL;


	SELECT * FROM Enrollment;


	SELECT s.stud_id,s.stud_name,
			COUNT(e.course_id) AS total_course
	FROM Student s
	JOIN Enrollment e 
	ON s.stud_id = e.stud_id
	GROUP BY s.stud_id,s.stud_name
	HAVING COUNT(e.course_id) > 3;


	SELECT s.stud_id,s.stud_name,s.dept_id,s.CGPA
	FROM Student s
	WHERE s.cgpa = (
		SELECT MAX(s2.CGPA)
		FROM Student s2
		WHERE s2.dept_id = s.dept_id);


		


