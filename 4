
CREATE DATABASE LIBRARY;
USE LIBRARY;

CREATE TABLE MEMBERS (
    MID INT PRIMARY KEY,
    Member_Name VARCHAR(50)
);

CREATE TABLE BOOKS (
    BID INT PRIMARY KEY,
    Book_Name VARCHAR(100),
    Category VARCHAR(50)
);

CREATE TABLE BORROW (
    MID INT,
    BID INT,
    Borrow_Date DATE,
    FOREIGN KEY (MID) REFERENCES MEMBERS(MID),
    FOREIGN KEY (BID) REFERENCES BOOKS(BID)
);

