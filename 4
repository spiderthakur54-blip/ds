SELECT bk.bid,bk.bname
FROM Book bk 
LEFT JOIN Borrow b
	ON bk.bid = b.bid
    AND b.borrow_data >= DATE_SUB(CURDATE(), INTERVAL 6 MONTH)
WHERE b.bid IS NULL;


