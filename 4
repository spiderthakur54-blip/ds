-- a) Members who borrowed more than 5 books in September 2026
SELECT M.MID, M.Member_Name,
       COUNT(B.BID) AS Total_Books
FROM MEMBERS M
JOIN BORROW B ON M.MID = B.MID
WHERE B.Borrow_Date >= '2026-09-01'
  AND B.Borrow_Date < '2026-10-01'
GROUP BY M.MID, M.Member_Name
HAVING COUNT(B.BID) > 5;

-- b) Books not borrowed in the last 6 months
SELECT B.BID, B.Book_Name
FROM BOOKS B
WHERE NOT EXISTS (
    SELECT *
    FROM BORROW BR
    WHERE BR.BID = B.BID
      AND BR.Borrow_Date >= DATE_SUB(CURDATE(), INTERVAL 6 MONTH)
);

-- c) Members who have never borrowed a book
SELECT M.MID, M.Member_Name
FROM MEMBERS M
LEFT JOIN BORROW B ON M.MID = B.MID
WHERE B.MID IS NULL;

-- d) Books borrowed by member with MID 101
SELECT B.BID, B.Book_Name
FROM BOOKS B
JOIN BORROW BR ON B.BID = BR.BID
WHERE BR.MID = 101;

-- e) Members who borrowed books from more than 3 categories
SELECT M.MID, M.Member_Name,
       COUNT(DISTINCT B.Category) AS Total_Categories
FROM MEMBERS M
JOIN BORROW BR ON M.MID = BR.MID
JOIN BOOKS B ON BR.BID = B.BID
GROUP BY M.MID, M.Member_Name
HAVING COUNT(DISTINCT B.Category) > 3;
