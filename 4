FROM Member m
JOIN Borrow b ON m.mid = b.mid 
WHERE b.borrow_data >= '2026-09-01'
	AND b.borrow_data < '2026-10-01'
GROUP BY m.mid,m.mname
HAVING COUNT(*) >5;

